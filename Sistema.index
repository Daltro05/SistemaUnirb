<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>TI Central</title><style>
:root{--n:#142b49;--b:#2868df;--bg:#f3f6fa;--ink:#1c2b40;--muted:#708097;--line:#e4eaf1;--green:#17865c;--amber:#b87512}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 "Segoe UI",Arial,sans-serif}button,input,select,textarea{font:inherit}.hidden{display:none!important}.auth{min-height:100vh;display:grid;place-items:center;padding:18px;background:linear-gradient(135deg,#edf4ff,#f7f9fc)}.authbox{width:min(420px,100%);background:#fff;border:1px solid var(--line);border-radius:14px;padding:28px;box-shadow:0 16px 50px #102b4b15}.authbrand{display:flex;align-items:center;gap:11px;font-size:21px;font-weight:700;margin-bottom:20px}.mark{width:40px;height:40px;border-radius:11px;background:linear-gradient(140deg,#3888ff,#4bc4b3);display:grid;place-items:center;color:white}.authbox h1{font-size:20px;margin:0 0 5px}.authbox p{color:var(--muted);font-size:13px;margin:0 0 18px}.field{margin:11px 0}.field label{display:block;color:#687a91;font-size:12px;margin-bottom:5px}.field input,.field select,.field textarea{width:100%;border:1px solid var(--line);border-radius:7px;padding:10px;outline-color:#a8c4f8}.btn{border:0;border-radius:6px;padding:9px 12px;background:var(--b);color:white;font-weight:600;font-size:12px;cursor:pointer}.btn.secondary{background:#edf1f6;color:#425570}.btn.danger{background:#fff0f0;color:#ab4141}.authbox .btn{width:100%;padding:11px;margin-top:7px}.msg{font-size:12px;color:#b43f3f;margin-top:11px;min-height:17px}.shell{display:flex;min-height:100vh}.side{width:242px;background:var(--n);color:#d6e1ef;padding:19px 12px;display:flex;flex-direction:column;flex-shrink:0}.brand{display:flex;gap:10px;align-items:center;padding:2px 10px 22px;color:white;font-size:17px;font-weight:700}.brand small{display:block;color:#91a7c2;font-size:9px;letter-spacing:.12em}.label{padding:13px 10px 6px;color:#8196b1;text-transform:uppercase;letter-spacing:.12em;font-size:10px}.nav{display:flex;gap:10px;align-items:center;padding:10px 11px;border-radius:7px;margin:2px 0;color:#c5d2e2;cursor:pointer;font-size:13px}.nav:hover,.nav.active{background:#254464;color:white}.nav.active{box-shadow:inset 3px 0 #51b8f5}.ico{width:19px;text-align:center;font-size:16px}.sidefoot{margin-top:auto;border-top:1px solid #2b4565;padding:13px 8px 0;display:flex;gap:9px;align-items:center;font-size:12px}.sidefoot b{display:block;color:white}.sidefoot small{color:#93a8c2}.main{flex:1;min-width:0}.top{height:64px;background:white;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 26px;position:sticky;top:0;z-index:2}.crumb{font-size:12px;color:var(--muted)}.crumb b{color:var(--ink)}.topright{display:flex;align-items:center;gap:12px;font-size:12px}.content{max-width:1450px;margin:auto;padding:25px 26px 45px}.heading{display:flex;justify-content:space-between;margin-bottom:18px}.heading h1{font-size:23px;margin:0 0 4px}.heading p{margin:0;color:var(--muted)}.tabs{display:flex;gap:5px;overflow:auto;border-bottom:1px solid var(--line);margin-bottom:16px}.tab{border:0;background:none;color:#708097;padding:10px 12px;border-bottom:2px solid transparent;white-space:nowrap;cursor:pointer;font-size:13px}.tab.active{color:var(--b);border-color:var(--b);font-weight:600}.page{display:none}.page.active{display:block}.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:11px;margin-bottom:15px}.card,.box{background:white;border:1px solid var(--line);border-radius:9px}.card{padding:14px}.ctop{display:flex;justify-content:space-between;color:#718097;font-size:12px}.symbol{background:#edf4ff;color:#3773d7;width:29px;height:29px;border-radius:8px;display:grid;place-items:center}.metric{font-size:24px;font-weight:700;margin:8px 0 2px}.hint,.sub{color:#8391a4;font-size:11px}.grid{display:grid;grid-template-columns:1.3fr 1fr;gap:13px}.box{padding:15px}.boxtitle{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;gap:9px}.boxtitle h2{font-size:15px;margin:0}.sub{margin-top:3px;font-size:12px}.tablewrap{overflow:auto}.table{width:100%;border-collapse:collapse;min-width:680px}.table th{text-align:left;text-transform:uppercase;font-size:10px;color:#8491a2;letter-spacing:.05em;padding:9px 7px;border-bottom:1px solid var(--line)}.table td{padding:9px 7px;border-bottom:1px solid #eef1f5;font-size:12px;vertical-align:middle}.table b{font-size:12px}.table input,.table select{border:1px solid var(--line);border-radius:5px;padding:6px;font-size:12px}.pill{display:inline-block;border-radius:20px;padding:4px 8px;background:#e8f6ef;color:#18805a;font-size:10px;white-space:nowrap}.pill.blue{background:#edf3ff;color:#3268c8}.pill.amber{background:#fff4df;color:#a76a0a}.filters{display:flex;gap:6px;align-items:center;flex-wrap:wrap}.input,.select{border:1px solid var(--line);border-radius:6px;padding:8px;color:#47576e;background:white;font-size:12px}.empty{padding:18px;text-align:center;color:#8190a4}.folder{border:1px solid var(--line);background:white;color:#5f7088;padding:7px 10px;border-radius:7px;cursor:pointer;font-size:12px;margin:2px}.folder.active{border-color:#8bb0fa;background:#eef4ff;color:#245fc9;font-weight:600}.map{height:205px;background:#f8fbff;border:1px solid #eaf0f6;border-radius:7px;position:relative}.map:before{content:"";position:absolute;height:2px;left:12%;right:12%;top:51%;background:#d6e5fa}.map:after{content:"";position:absolute;width:2px;top:20%;bottom:20%;left:50%;background:#d6e5fa}.node{position:absolute;z-index:1;width:112px;background:white;border:1px solid #dce6f2;border-radius:8px;padding:7px;text-align:center;font-size:10px}.node b{display:block}.node span{color:#7d8b9d;font-size:9px}.router{left:calc(50% - 56px);top:calc(50% - 23px)}.n1{left:5%;top:10%}.n2{right:5%;top:10%}.n3{left:5%;bottom:9%}.n4{right:5%;bottom:9%}.activity{display:flex;gap:9px;padding:9px 0;border-bottom:1px solid #eff2f6;font-size:12px;align-items:center}.activity:last-child{border:0}.activity small{display:block;color:#8492a4;margin-top:2px}.modalback{display:none;position:fixed;inset:0;background:#14243c77;z-index:5;align-items:center;justify-content:center;padding:16px}.modalback.open{display:flex}.modal{background:white;border-radius:11px;width:min(560px,100%);max-height:90vh;overflow:auto;padding:20px}.modalhead,.modalfoot{display:flex;justify-content:space-between;align-items:center;margin-bottom:13px}.modalhead h2{font-size:17px;margin:0}.close{border:0;background:none;font-size:22px;cursor:pointer}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.formgrid .field{margin:3px 0}.field.full{grid-column:1/-1}.modalfoot{justify-content:flex-end;gap:8px;margin:14px 0 0}.note{font-size:11px;color:#8391a4;margin:10px 0}@media(max-width:900px){.side{width:195px}.cards{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr}}@media(max-width:650px){.side{width:55px;padding:13px 5px}.brand{padding:0 4px 19px}.brand>span:not(.mark),.label,.nav .nt,.sidefoot>div:not(.avatar){display:none}.nav{justify-content:center;padding:10px 0}.top{padding:0 10px}.content{padding:17px 10px}.heading{display:block}.cards{gap:7px}.card{padding:10px}.metric{font-size:20px}.formgrid{grid-template-columns:1fr}.field.full{grid-column:auto}}
</style></head><body>
<section id="auth" class="auth"><form id="authForm" class="authbox"><div class="authbrand"><span class="mark">TI</span> TI Central</div><h1 id="authTitle">Acessar sistema</h1><p id="authIntro">Entre com seu usuário para acessar os módulos de TI.</p><div id="authFields"></div><button class="btn" id="authButton">Entrar</button><div id="authMsg" class="msg"></div></form></section>
<div id="app" class="shell hidden"><aside class="side"><div class="brand"><span class="mark">TI</span><span>TI Central<small>GESTÃO DE TECNOLOGIA</small></span></div><div class="label">Operação</div><div class="nav active" data-page="home"><span class="ico">⌂</span><span class="nt">Visão geral</span></div><div class="label">Módulos</div><div class="nav" data-page="ips"><span class="ico">⌘</span><span class="nt">Planilha de IPs</span></div><div class="nav" data-page="network"><span class="ico">⌁</span><span class="nt">Mapa de redes</span></div><div class="nav" data-page="machines"><span class="ico">▣</span><span class="nt">Máquinas</span></div><div class="nav" data-page="stock"><span class="ico">▤</span><span class="nt">Suprimentos</span></div><div class="nav" data-page="tickets"><span class="ico">◉</span><span class="nt">Chamados</span></div><div class="label">Administração</div><div class="nav" data-page="locations"><span class="ico">▱</span><span class="nt">Locais e pastas</span></div><div class="nav" data-page="users" id="usersNav"><span class="ico">♙</span><span class="nt">Usuários e acessos</span></div><div class="sidefoot"><div class="avatar">TI</div><div><b id="userName">Equipe</b><small id="userRole">Administrador</small></div></div></aside><main class="main"><header class="top"><div class="crumb">TI Central / <b id="crumb">Visão geral</b></div><div class="topright"><span id="topUser"></span><button class="btn secondary" onclick="logout()">Sair</button></div></header><div class="content"><div class="heading"><div><h1 id="title">Painel de TI</h1><p id="subtitle">Resumo da infraestrutura, ativos e solicitações internas.</p></div><div class="hint">Dados centralizados no banco do sistema</div></div><div class="tabs"><button class="tab active" data-target="home">Resumo</button><button class="tab" data-target="ips">Planilha de IPs</button><button class="tab" data-target="machines">Máquinas</button><button class="tab" data-target="stock">Suprimentos</button><button class="tab" data-target="tickets">Chamados</button></div>
<section class="page active" id="page-home"><div class="cards" id="summary"></div><div class="grid"><div class="box"><div class="boxtitle"><div><h2>Locais e pastas</h2><div class="sub">Infraestrutura organizada por unidade</div></div><button class="btn secondary" onclick="go('locations')">Gerenciar</button></div><div id="homeFolders"></div><div class="map" id="homeMap"></div></div><div class="box"><div class="boxtitle"><div><h2>Chamados recentes</h2><div class="sub">Solicitações internas</div></div><button class="btn" onclick="openForm('tickets')">＋ Abrir chamado</button></div><div id="recent"></div></div></div></section>
<section class="page" id="page-ips"><div class="boxtitle"><div><h2>Planilha de endereços IP</h2><div class="sub">Relação por setor, funcionário e IP, com filtros e exportação CSV</div></div><div class="filters"><button class="btn secondary" onclick="downloadCsv()">Exportar CSV</button><button class="btn" onclick="openForm('ips')">＋ Adicionar IP</button></div></div><div class="cards" id="ipCards"></div><div class="box"><div class="boxtitle"><h2>Alocações de IP</h2><div class="filters"><input class="input" id="ipSearch" placeholder="Buscar setor, funcionário ou IP"><select class="select" id="sectorFilter"><option value="">Todos os setores</option></select></div></div><div class="tablewrap"><table class="table"><thead><tr><th>Setor</th><th>Funcionário</th><th>Endereço IP</th><th>Dispositivo</th><th>MAC</th><th>Local</th><th></th></tr></thead><tbody id="ipRows"></tbody></table></div></div><p class="note">Os endereços IP são validados e não podem ser duplicados. Dados fictícios não são pré-carregados.</p></section>
<section class="page" id="page-network"><div class="boxtitle"><div><h2>Mapa de redes</h2><div class="sub">Mapa lógico e equipamentos da infraestrutura</div></div><button class="btn" onclick="openForm('network')">＋ Dispositivo</button></div><div id="networkFolders"></div><div class="grid"><div class="box"><h2 style="font-size:15px">Topologia · <span id="mapTitle"></span></h2><div id="networkMap" class="map"></div></div><div class="box"><h2 style="font-size:15px">Dispositivos cadastrados</h2><div id="netRows"></div></div></div></section>
<section class="page" id="page-machines"><div class="boxtitle"><div><h2>Inventário de máquinas</h2><div class="sub">Patrimônio, usuário, SO, IP e configuração de hardware</div></div><button class="btn" onclick="openForm('machines')">＋ Máquina</button></div><div class="box"><div class="boxtitle"><h2>Equipamentos</h2><input class="input" id="machineSearch" placeholder="Buscar equipamento / usuário"></div><div class="tablewrap"><table class="table"><thead><tr><th>Patrimônio / equipamento</th><th>Usuário</th><th>SO</th><th>IP</th><th>Processador / RAM</th><th>Armazenamento</th><th>Local</th></tr></thead><tbody id="machineRows"></tbody></table></div></div></section>
<section class="page" id="page-stock"><div class="boxtitle"><div><h2>Inventário de suprimentos</h2><div class="sub">Toners, cabos, teclados, mouses, monitores e acessórios</div></div><button class="btn" onclick="openForm('supplies')">＋ Registrar item</button></div><div class="box"><div class="boxtitle"><h2>Estoque</h2><input class="input" id="stockSearch" placeholder="Buscar item"></div><div class="tablewrap"><table class="table"><thead><tr><th>Item</th><th>Categoria</th><th>Marca / modelo</th><th>Quantidade</th><th>Mínimo</th><th>Local</th><th></th></tr></thead><tbody id="stockRows"></tbody></table></div></div></section>
<section class="page" id="page-tickets"><div class="boxtitle"><div><h2>Central de chamados</h2><div class="sub">Abertura e acompanhamento de solicitações</div></div><button class="btn" onclick="openForm('tickets')">＋ Abrir chamado</button></div><div class="cards" id="ticketCards"></div><div class="box"><div class="boxtitle"><h2>Fila de atendimento</h2><input class="input" id="ticketSearch" placeholder="Buscar chamado / solicitante"></div><div class="tablewrap"><table class="table"><thead><tr><th>ID</th><th>Assunto</th><th>Solicitante</th><th>Categoria</th><th>Prioridade</th><th>Status</th><th>Local / data</th></tr></thead><tbody id="ticketRows"></tbody></table></div></div></section>
<section class="page" id="page-locations"><div class="boxtitle"><div><h2>Locais e pastas</h2><div class="sub">Organização da documentação por unidade</div></div><button class="btn" onclick="openForm('locations')">＋ Criar pasta</button></div><div id="locationRows" class="cards"></div></section>
<section class="page" id="page-users"><div class="boxtitle"><div><h2>Gerenciamento de usuários</h2><div class="sub">Contas de acesso, perfis e ativação</div></div><button class="btn" onclick="openForm('user')">＋ Novo usuário</button></div><div class="box"><div class="tablewrap"><table class="table"><thead><tr><th>Nome</th><th>Usuário</th><th>Perfil</th><th>Situação</th><th>Criado em</th><th>Ações</th></tr></thead><tbody id="userRows"></tbody></table></div></div><p class="note">Administrador gerencia usuários. Técnico usa os módulos; Consulta tem acesso somente de leitura operacional.</p></section>
</div></main></div><div class="modalback" id="back"><div class="modal"><div class="modalhead"><h2 id="modalTitle">Cadastro</h2><button class="close" onclick="closeForm()">×</button></div><form id="form"><div id="formBody" class="formgrid"></div><div id="formMsg" class="msg"></div><div class="modalfoot"><button type="button" class="btn secondary" onclick="closeForm()">Cancelar</button><button class="btn" type="submit">Salvar</button></div></form></div></div>
<script>
let me=null,setup=false,loc='Matriz';const S={ips:[],network:[],machines:[],supplies:[],tickets:[],locations:[],users:[]};const $=s=>document.querySelector(s),esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));async function api(path,method='GET',body){let r=await fetch('/api/'+path,{method,headers:body?{'Content-Type':'application/json'}:{},body:body?JSON.stringify(body):undefined});let d=await r.json().catch(()=>({}));if(!r.ok)throw Error(d.error||'Falha na solicitação');return d}function msg(id,text){$(id).textContent=text}
async function boot(){try{let x=await api('setup-status');setup=x.setup_required;renderAuth();if(!setup){try{let r=await api('me');me=r.user;await loadAll();showApp()}catch{}}}catch{renderAuth('Não foi possível conectar ao servidor. Inicie server.py e recarregue esta página.')}}function renderAuth(error=''){ $('#authTitle').textContent=setup?'Criar administrador inicial':'Acessar sistema';$('#authIntro').textContent=setup?'Crie a primeira conta com perfil administrador. Use uma senha única com pelo menos 12 caracteres.':'Entre com seu usuário para acessar os módulos de TI.';$('#authFields').innerHTML=setup?'<div class="field"><label>Nome completo</label><input name="display_name" required></div><div class="field"><label>Usuário</label><input name="username" minlength="3" required></div><div class="field"><label>Senha (mínimo 12 caracteres)</label><input name="password" type="password" minlength="12" required></div>':'<div class="field"><label>Usuário</label><input name="username" autocomplete="username" required></div><div class="field"><label>Senha</label><input name="password" type="password" autocomplete="current-password" required></div>';$('#authButton').textContent=setup?'Criar administrador':'Entrar';msg('#authMsg',error)}$('#authForm').onsubmit=async e=>{e.preventDefault();let d=Object.fromEntries(new FormData(e.target));try{let r=await api(setup?'setup':'login','POST',d);me=r.user;await loadAll();showApp()}catch(err){msg('#authMsg',err.message)}};
async function loadAll(){for(let k of ['ips','network','machines','supplies','tickets','locations'])S[k]=await api('data/'+k);if(me.role==='admin')S.users=await api('users')}function showApp(){$('#auth').classList.add('hidden');$('#app').classList.remove('hidden');$('#userName').textContent=me.display_name;$('#userRole').textContent={admin:'Administrador',tecnico:'Técnico',consulta:'Consulta'}[me.role]||me.role;$('#topUser').textContent=me.display_name;$('#usersNav').classList.toggle('hidden',me.role!=='admin');render()}async function logout(){await api('logout','POST',{});me=null;S.users=[];$('#app').classList.add('hidden');$('#auth').classList.remove('hidden');setup=false;renderAuth()}
function cards(id,items){$(id).innerHTML=items.map((x,i)=>`<div class="card"><div class="ctop">${x[0]}<span class="symbol">${['⌘','▣','▤','◉'][i%4]}</span></div><div class="metric">${x[1]}</div><div class="hint">${x[2]||'Sistema de TI'}</div></div>`).join('')}function pill(x){return `<span class="pill ${['Alta','Crítica','Aberto','Repor'].includes(x)?'amber':x==='Em atendimento'?'blue':''}">${esc(x)}</span>`}function render(){let pending=S.tickets.filter(t=>t.status!=='Resolvido').length;cards('#summary',[['Endereços IP',S.ips.length,'Setor · funcionário · IP'],['Máquinas',S.machines.length,'Inventário de equipamentos'],['Itens em estoque',S.supplies.reduce((n,x)=>n+(+x.qty||0),0),'Unidades cadastradas'],['Chamados pendentes',pending,'Solicitações não resolvidas']]);$('#homeFolders').innerHTML=S.locations.map(x=>`<button class="folder" onclick="go('network')">▰ ${esc(x.name||x)}</button>`).join('')||'<div class="empty">Cadastre os locais nas pastas.</div>';drawMap('#homeMap');$('#recent').innerHTML=S.tickets.slice(0,4).map(t=>`<div class="activity"><span class="symbol">◉</span><div style="flex:1"><b>${esc(t.subject)}</b><small>${esc(t.id||'')} · ${esc(t.requester)} · ${esc(t.date||'')}</small></div>${pill(t.status)}</div>`).join('')||'<div class="empty">Nenhum chamado.</div>';drawIps();drawNetwork();drawMachines();drawSupplies();drawTickets();drawLocations();if(me.role==='admin')drawUsers()}
function drawIps(){cards('#ipCards',[['Alocações cadastradas',S.ips.length,'Endereços na base'],['Setores',new Set(S.ips.map(x=>x.setor)).size,'Setores atendidos'],['Funcionários',new Set(S.ips.map(x=>x.funcionario)).size,'Usuários mapeados'],['Locais',new Set(S.ips.map(x=>x.local).filter(Boolean)).size,'Unidades cadastradas']]);let sectors=[...new Set(S.ips.map(x=>x.setor))];$('#sectorFilter').innerHTML='<option value="">Todos os setores</option>'+sectors.map(s=>`<option>${esc(s)}</option>`).join('');let q=$('#ipSearch').value.toLowerCase(),f=$('#sectorFilter').value;$('#ipRows').innerHTML=S.ips.filter(x=>(!q||Object.values(x).join(' ').toLowerCase().includes(q))&&(!f||x.setor===f)).map(x=>`<tr><td>${esc(x.setor)}</td><td>${esc(x.funcionario)}</td><td><b>${esc(x.ip)}</b></td><td>${esc(x.dispositivo)}</td><td>${esc(x.mac)}</td><td>${esc(x.local)}</td><td><button class="btn danger" onclick="del('ips',${x.id})">Excluir</button></td></tr>`).join('')||'<tr><td colspan="7" class="empty">Sem alocações. Use “Adicionar IP” para alimentar a planilha.</td></tr>'}
function drawMap(target){let d=S.network.filter(x=>!x.local||x.local===loc),base='10.20.1';$(target).innerHTML=[['Roteador','router',base+'.1'],['Switch','n1',base+'.2'],['Access point','n2',base+'.21'],['Servidor','n3',base+'.10'],['Impressora','n4',base+'.35']].map(([t,c,ip])=>{let r=d.find(x=>x.type===t);return `<div class="node ${c}"><b>${esc(r?.name||t)}</b><span>${esc(r?.ip||ip)}</span></div>`}).join('')}function drawNetwork(){$('#networkFolders').innerHTML=S.locations.map(l=>`<button class="folder" onclick="loc='${esc(l.name||l)}';drawMap('#networkMap');$('#mapTitle').textContent=loc">▰ ${esc(l.name||l)}</button>`).join('');$('#mapTitle').textContent=loc;drawMap('#networkMap');$('#netRows').innerHTML=S.network.map(x=>`<div class="activity"><div><b>${esc(x.name)}</b><small>${esc(x.type)} · ${esc(x.ip)} · ${esc(x.local)}</small></div></div>`).join('')||'<div class="empty">Cadastre equipamentos de rede.</div>'}
function drawMachines(){let q=$('#machineSearch').value.toLowerCase();$('#machineRows').innerHTML=S.machines.filter(x=>!q||Object.values(x).join(' ').toLowerCase().includes(q)).map(x=>`<tr><td><b>${esc(x.tag)} · ${esc(x.name)}</b></td><td>${esc(x.user)}</td><td>${esc(x.os)}</td><td>${esc(x.ip)}</td><td>${esc(x.cpu)} · ${esc(x.ram)}</td><td>${esc(x.storage)}</td><td>${esc(x.location)}</td></tr>`).join('')||'<tr><td colspan="7" class="empty">Nenhuma máquina cadastrada.</td></tr>'}function drawSupplies(){let q=$('#stockSearch').value.toLowerCase();$('#stockRows').innerHTML=S.supplies.filter(x=>!q||Object.values(x).join(' ').toLowerCase().includes(q)).map(x=>`<tr><td><b>${esc(x.name)}</b></td><td>${esc(x.category)}</td><td>${esc(x.model)}</td><td>${esc(x.qty)}</td><td>${esc(x.min)}</td><td>${esc(x.location)}</td><td>${+x.qty<=+x.min?pill('Repor'):pill('Disponível')}</td></tr>`).join('')||'<tr><td colspan="7" class="empty">Nenhum item cadastrado.</td></tr>'}
function drawTickets(){let q=$('#ticketSearch').value.toLowerCase();cards('#ticketCards',[['Chamados',S.tickets.length],['Pendentes',S.tickets.filter(x=>x.status!=='Resolvido').length],['Prioridade alta',S.tickets.filter(x=>['Alta','Crítica'].includes(x.priority)&&x.status!=='Resolvido').length],['Resolvidos',S.tickets.filter(x=>x.status==='Resolvido').length]]);$('#ticketRows').innerHTML=S.tickets.filter(x=>!q||Object.values(x).join(' ').toLowerCase().includes(q)).map(x=>`<tr><td>${esc(x.id)}</td><td><b>${esc(x.subject)}</b><div class="hint">${esc(x.description)}</div></td><td>${esc(x.requester)}</td><td>${esc(x.category)}</td><td>${pill(x.priority)}</td><td>${me.role==='consulta'?pill(x.status):`<select onchange="status(${x.record_id},this.value)">${['Aberto','Em atendimento','Aguardando usuário','Resolvido'].map(s=>`<option ${x.status===s?'selected':''}>${s}</option>`).join('')}</select>`}</td><td>${esc(x.location)}<div class="hint">${esc(x.date)}</div></td></tr>`).join('')||'<tr><td colspan="7" class="empty">Nenhum chamado.</td></tr>'}function drawLocations(){$('#locationRows').innerHTML=S.locations.map(x=>`<div class="card"><div class="ctop">▰ Pasta do local</div><div class="metric" style="font-size:17px">${esc(x.name||x)}</div><div class="hint">Clique para abrir o mapa deste local</div><button class="btn secondary" style="margin-top:10px" onclick="loc='${esc(x.name||x)}';go('network')">Abrir pasta</button></div>`).join('')}function drawUsers(){$('#userRows').innerHTML=S.users.map(u=>`<tr><td><b>${esc(u.display_name)}</b></td><td>${esc(u.username)}</td><td><select onchange="userPatch(${u.id},{role:this.value})">${['admin','tecnico','consulta'].map(r=>`<option value="${r}" ${r===u.role?'selected':''}>${{admin:'Administrador',tecnico:'Técnico',consulta:'Consulta'}[r]}</option>`).join('')}</select></td><td>${u.active?'Ativo':'Inativo'}</td><td>${esc(u.created_at)}</td><td><button class="btn secondary" onclick="resetPassword(${u.id})">Redefinir senha</button> <button class="btn ${u.active?'danger':'secondary'}" onclick="userPatch(${u.id},{active:${!u.active}})">${u.active?'Desativar':'Ativar'}</button></td></tr>`).join('')}
const pages={home:['Painel de TI','Resumo da infraestrutura, ativos e solicitações.'],ips:['Planilha de IPs','Relação de endereços por setor e funcionário.'],network:['Mapa de redes','Mapa lógico e dispositivos de infraestrutura.'],machines:['Inventário de máquinas','Patrimônio, SO, IP e configuração de hardware.'],stock:['Suprimentos','Controle de itens e níveis mínimos de estoque.'],tickets:['Central de chamados','Abertura e acompanhamento de solicitações.'],locations:['Locais e pastas','Organização por unidade.'],users:['Usuários e acessos','Contas de acesso, perfis e ativação.']};function go(k){if(k==='users'&&me.role!=='admin')return;$('#title').textContent=pages[k][0];$('#subtitle').textContent=pages[k][1];$('#crumb').textContent=pages[k][0];document.querySelectorAll('.page').forEach(x=>x.classList.toggle('active',x.id==='page-'+k));document.querySelectorAll('.nav').forEach(x=>x.classList.toggle('active',x.dataset.page===k));document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x.dataset.target===k))}document.querySelectorAll('.nav').forEach(x=>x.onclick=()=>go(x.dataset.page));document.querySelectorAll('.tab').forEach(x=>x.onclick=()=>go(x.dataset.target));
const specs={ips:['Setor|text|1','Funcionário|text|1','IP|text|1','Dispositivo|text','MAC|text','Local|text','Observações|textarea'],network:['Nome|text|1','Tipo|select:Roteador,Switch,Access point,Servidor,Impressora|1','IP|text|1','MAC|text','Local|text'],machines:['Patrimônio|text|1','Equipamento|text|1','Usuário|text','Sistema operacional|select:Windows 11,Windows 10,Windows Server 2022,Ubuntu 24.04,macOS,Outro|1','IP|text','Processador|text','Memória RAM|text','Armazenamento|text','Local|text'],supplies:['Item|text|1','Categoria|select:Toner,Cabo,Teclado,Mouse,Monitor,Outros|1','Marca / modelo|text','Quantidade|number|1','Mínimo|number|1','Local de armazenamento|text'],tickets:['Assunto|text|1','Solicitante|text|1','Categoria|select:Hardware,Software,Rede e acesso,Periféricos,Acesso e permissões,Outro|1','Prioridade|select:Crítica,Alta,Normal,Baixa|1','Local|text|1','Descrição|textarea|1'],locations:['Nome do local / pasta|text|1'],user:['Nome completo|text|1','Usuário|text|1','Senha|password|1','Perfil|select:tecnico,consulta,admin|1']};let formKind='';function openForm(k){if(me.role==='consulta')return;formKind=k;$('#modalTitle').textContent={ips:'Adicionar alocação de IP',network:'Cadastrar dispositivo de rede',machines:'Cadastrar máquina',supplies:'Registrar suprimento',tickets:'Abrir chamado',locations:'Criar pasta / local',user:'Criar usuário'}[k];$('#formMsg').textContent='';$('#formBody').innerHTML=specs[k].map(s=>{let [label,type,req]=s.split('|'),key=({Funcionário:'funcionario',IP:'ip',Dispositivo:'dispositivo',MAC:'mac',Local:'local',Observações:'observacoes',Nome:'name',Tipo:'type',Patrimônio:'tag',Equipamento:'name',Usuário:'user',Senha:'password', 'Sistema operacional':'os','Processador':'cpu','Memória RAM':'ram','Armazenamento':'storage',Item:'name',Categoria:'category',Quantidade:'qty',Mínimo:'min','Marca / modelo':'model','Local de armazenamento':'location',Assunto:'subject',Solicitante:'requester',Prioridade:'priority',Descrição:'description','Nome do local / pasta':'name','Nome completo':'display_name','Perfil':'role'}[label]||label.toLowerCase());let ctl=type.startsWith('select:')?`<select name="${key}" ${req?'required':''}>${type.slice(7).split(',').map(v=>`<option>${v}</option>`).join('')}</select>`:type==='textarea'?`<textarea name="${key}" ${req?'required':''}></textarea>`:`<input name="${key}" type="${type}" ${req?'required':''} ${type==='number'?'min="0"':''} ${type==='password'?'minlength="12"':''}>`;return `<div class="field ${type==='textarea'?'full':''}"><label>${label}${req?' *':''}</label>${ctl}</div>`}).join('');$('#back').classList.add('open')}function closeForm(){$('#back').classList.remove('open')}$('#back').onclick=e=>{if(e.target.id==='back')closeForm()};
$('#form').onsubmit=async e=>{e.preventDefault();let d=Object.fromEntries(new FormData(e.target));try{if(formKind==='user'){d.username=d.user;delete d.user;await api('users','POST',d)}else{if(['machines','tickets'].includes(formKind)&&d.local){d.location=d.local;delete d.local}if(formKind==='tickets'){d.id='CH-'+(1000+S.tickets.length+1);d.status='Aberto';d.date=new Date().toLocaleDateString('pt-BR')}await api('data/'+formKind,'POST',d)}closeForm();await loadAll();render()}catch(err){msg('#formMsg',err.message)}};async function del(entity,id){if(!confirm('Excluir este registro?'))return;try{await api('data/'+entity+'/'+id,'DELETE');await loadAll();render()}catch(e){alert(e.message)}}async function status(id,value){try{await api('tickets/'+id+'/status','PATCH',{status:value});await loadAll();render()}catch(e){alert(e.message)}}async function userPatch(id,body){try{await api('users/'+id,'PATCH',body);S.users=await api('users');drawUsers()}catch(e){alert(e.message)}}async function resetPassword(id){let p=prompt('Nova senha (mínimo 12 caracteres):');if(p===null)return;try{await userPatch(id,{password:p})}catch(e){alert(e.message)}}
function downloadCsv(){let rows=[['Setor','Funcionário','IP','Dispositivo','MAC','Local','Observações'],...S.ips.map(x=>[x.setor,x.funcionario,x.ip,x.dispositivo,x.mac,x.local,x.observacoes])];let csv='\ufeff'+rows.map(r=>r.map(v=>'"'+String(v||'').replaceAll('"','""')+'"').join(';')).join('\r\n'),a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));a.download='inventario-ips.csv';a.click();URL.revokeObjectURL(a.href)}$('#ipSearch').oninput=drawIps;$('#sectorFilter').onchange=drawIps;$('#machineSearch').oninput=drawMachines;$('#stockSearch').oninput=drawSupplies;$('#ticketSearch').oninput=drawTickets;
boot();
</script></body></html>
